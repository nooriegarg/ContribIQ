# ContribIQ — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (with pgvector extension enabled)
DATABASE_URL=postgresql+asyncpg://contribiq:password@localhost:5432/contribiq

# ─── Security ────────────────────────────────────────────────────────────────
# Long random string used to sign JWT tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Callback URL during development: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ─── Application URLs ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# ─── Valkey (cache + task queue) ──────────────────────────────────────────────
# Valkey is a BSD-licensed Redis-compatible store (Linux Foundation fork of Redis)
VALKEY_URL=redis://localhost:6379/0

# ─── Ollama (local LLM server) ────────────────────────────────────────────────
# Run locally with: docker compose exec ollama ollama pull qwen2.5-coder:7b
OLLAMA_URL=http://localhost:11434
